# Dentro do docker compose o Postgres responde no hostname "db".
# Para scripts rodando fora do Docker (ex: run_migrations.py), use localhost:5432.
DATABASE_URL=postgresql://myfinance:myfinance@db:5432/myfinance
ENVIRONMENT=development
# Vazio = bypass de auth local (token "local-dev"). Preencher para usar Supabase real.
SUPABASE_URL=
